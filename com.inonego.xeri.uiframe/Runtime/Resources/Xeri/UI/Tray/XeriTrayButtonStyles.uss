.xeri-tray-button {
    --xeri-tray-button-state-marker-color: rgb(80, 150, 255);

    min-width: 24px;
    min-height: 24px;
    height: 24px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 0;
    padding-bottom: 0;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.xeri-tray-button--reordering {
    transition-duration: 0s;
}

.xeri-tray-button--reorder-proxy {
    transition-duration: 0s;
}

.xeri-tray-button__state-marker {
    width: 3px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: var(--xeri-tray-button-state-marker-color);
}

.xeri-tray-button__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 4px;
}

.xeri-tray-button__title {
    min-width: 0;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

/* 항목 배지는 Core Badge이며 크기는 Badge 변수로 줄인다. 배경색은 항목 데이터(XeriTrayBadge.Color)가 정한다. */
.xeri-tray-button__badge {
    --xeri-badge-height: 14px;
    --xeri-badge-padding: 3px;

    min-width: 14px;
}

/* 배지 앞 간격은 배치를 맡은 버튼이 정한다. */
.xeri-tray-button > .xeri-tray-button__badge {
    margin-left: 4px;
}

.xeri-tray-button__close-button {
    position: relative;
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
}

.xeri-tray-button__close-icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
